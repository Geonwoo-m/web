<div class="my-5">
    <h1 class="text-center my-5">학생관리</h1>
    <div class ="text-end mb-2">
        <a class="btn btn-primary px-3" href="/haksa/stu/insert">학생등록</a>
    </div>
    <table id="tbl" class ="table table-striped table holder"></table>
    <script id="temp" type="text/x-handlebars-template">
        <tbody>
            {{#each .}}
            <tr>
                <td>{{SCODE}}</td>
                <td>{{SNAME}}</td>
                <td>{{DEPT}}</td>
                <td>{{FDATE}}</td>
                <td>{{YEAR}}</td>
                <td>{{PNAME}}({{ADVISOR}})</td>
            </tr>
            {{/each}}
        </tbody>
    </script>
</div>

<script>
    getList();
    function getList(){
        $.ajax({
            type:"get",
            url:"/haksa/stu/list.json",
            success:function(data){
                // console.log(data);
                const temp = Handlebars.compile($("#temp").html());
                $("#tbl").html(temp(data));
            }
        })
    }
</script>